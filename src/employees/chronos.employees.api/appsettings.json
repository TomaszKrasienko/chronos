{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://localhost:8081",
        "Protocols": "Http2"
      }
    }
  },
  "AppOptions": {
    "Name": "Employees"
  },
  "DalOptions": {
    "ConnectionString": "ConnectionString",
    "DatabaseName": "DatabaseName"
  },
  "GrpcCommunicationOptions": {
    "Enabled": false
  },
  "RabbitMqOptions": {
    "HostName": "localhost",
    "Port": 5672,
    "Username": "username",
    "Password": "password",
    "VirtualHost": "/",
    "Routes": {
      "chronos.employees.core.Events.EmployeeCreated": {
        "Exchange": "chronos_employees_core",
        "RoutingKeys": [
          "employee_created"
        ],
        "IsTemporary": true
      }
    }
  }
}
