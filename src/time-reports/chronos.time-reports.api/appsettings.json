{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppOptions": {
    "Name": "Time Reports"
  },
  "SavingOptions": {
    "Path": "/app/reports"
  },
  "DalOptions": {
    "ConnectionString": "ConnectionString",
    "DatabaseName": "DatabaseName"
  },
  "RabbitMqOptions": {
    "HostName": "localhost",
    "Port": 5672,
    "Username": "username",
    "Password": "password",
    "VirtualHost": "/",
    "Routes": {
      "chronos.time_reports.core.Events.TimeLogAccepted": {
        "Exchange": "chronos_time_loggers_core",
        "Queue": "time_reports_time_log_accepted",
        "RoutingKeys": [
          "time_log_accepted"
        ],
        "IsTemporary": false
      },
      "chronos.time_reports.core.Events.TimeLogRejected": {
        "Exchange": "chronos_time_loggers_core",
        "Queue": "time_reports_time_log_rejected",
        "RoutingKeys": [
          "time_log_rejected"
        ],
        "IsTemporary": false
      }
    }
  }
}
