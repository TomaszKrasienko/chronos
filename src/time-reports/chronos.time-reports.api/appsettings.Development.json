{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SavingOptions": {
    "Path": "./reports"
  },
  "DalOptions": {
    "ConnectionString": "mongodb://localhost:10011",
    "DatabaseName": "TimeReports_Local"
  },
  "RabbitMqOptions": {
    "HostName": "localhost",
    "Port": 10012,
    "Username": "admin",
    "Password": "123456",
    "VirtualHost": "chronos",
    "Routes": {
      "chronos.time_reports.core.Events.TimeLogAccepted": {
        "Exchange": "chronos_time_loggers_core",
        "Queue": "time_reports_time_log_accepted",
        "RoutingKeys": [
          "time_log_accepted"
        ],
        "IsTemporary": false
      },
      "chronos.time_reports.core.Events.TimeLogRejected": {
        "Exchange": "chronos_time_loggers_core",
        "Queue": "time_reports_time_log_rejected",
        "RoutingKeys": [
          "time_log_rejected"
        ],
        "IsTemporary": false
      }
    }
  }
}
