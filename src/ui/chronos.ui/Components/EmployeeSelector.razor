@inject IEmployeeService EmployeeService
@inject AppStateService AppState

<div class="card mb-3">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-auto">
                <i class="bi bi-person-circle fs-4 text-primary"></i>
            </div>
            <div class="col">
                <label class="form-label mb-1 fw-bold">Acting as Employee:</label>
                @if (_isLoading)
                {
                    <div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                }
                else if (_employees.Count == 0)
                {
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>No employees available
                    </div>
                }
                else
                {
                    <select class="form-select" @bind="SelectedEmployeeId" @bind:after="OnEmployeeChanged">
                        <option value="">-- Select Employee --</option>
                        @foreach (var employee in _employees)
                        {
                            <option value="@employee.Id">@employee.FullName (@employee.Email)</option>
                        }
                    </select>
                }
            </div>
            @if (!string.IsNullOrEmpty(SelectedEmployeeId))
            {
                <div class="col-auto">
                    <span class="badge bg-success">
                        <i class="bi bi-check-circle me-1"></i>Selected
                    </span>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(SelectedEmployeeId))
        {
            var selectedEmployee = _employees.FirstOrDefault(e => e.Id == SelectedEmployeeId);
            if (selectedEmployee != null)
            {
                <div class="mt-2 p-2 bg-light rounded">
                    <small class="text-muted">
                        <strong>Current Context:</strong> @selectedEmployee.FullName
                        @if (!string.IsNullOrEmpty(selectedEmployee.SupervisorId))
                        {
                            var supervisor = _employees.FirstOrDefault(e => e.Id == selectedEmployee.SupervisorId);
                            if (supervisor != null)
                            {
                                <span class="ms-2">| <strong>Supervisor:</strong> @supervisor.FullName</span>
                            }
                        }
                    </small>
                </div>
            }
        }
    </div>
</div>

@code {
    private IReadOnlyCollection<Employee> _employees = [];
    private bool _isLoading = false;
    private string? _selectedEmployeeId;

    private string? SelectedEmployeeId
    {
        get => _selectedEmployeeId ?? AppState.CurrentEmployeeId;
        set => _selectedEmployeeId = value;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();

        // Set default if available
        if (_employees.Count > 0 && string.IsNullOrEmpty(AppState.CurrentEmployeeId))
        {
            SelectedEmployeeId = _employees.First().Id;
            OnEmployeeChanged();
        }
        else if (!string.IsNullOrEmpty(AppState.CurrentEmployeeId))
        {
            SelectedEmployeeId = AppState.CurrentEmployeeId;
        }
    }

    private async Task LoadEmployees()
    {
        try
        {
            _isLoading = true;
            _employees = await EmployeeService.GetAllAsync();
        }
        catch (Exception)
        {
            // Silently fail, employees list will be empty
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnEmployeeChanged()
    {
        AppState.CurrentEmployeeId = SelectedEmployeeId;

        // Determine context based on whether employee has subordinates
        if (!string.IsNullOrEmpty(SelectedEmployeeId))
        {
            var hasSubordinates = _employees.Any(e => e.SupervisorId == SelectedEmployeeId);
            AppState.CurrentContext = hasSubordinates
                ? Models.AppContext.Supervisor
                : Models.AppContext.Employee;
        }
    }
}
