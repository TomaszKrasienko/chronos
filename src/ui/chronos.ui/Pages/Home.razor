@page "/"

<PageTitle>Home - Chronos</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>Welcome to Chronos</h1>
            <p class="lead">Time Tracking System</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-people-fill me-2"></i>Employees
                    </h5>
                    <p class="card-text">Manage employees and supervisors</p>
                    <a href="/employees" class="btn btn-light btn-sm">View <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-clock-fill me-2"></i>Time Logs
                    </h5>
                    <p class="card-text">Track and approve work hours</p>
                    <a href="/time-logs" class="btn btn-light btn-sm">View <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-bar-chart-fill me-2"></i>Reports
                    </h5>
                    <p class="card-text">View time tracking reports</p>
                    <a href="/time-reports" class="btn btn-light btn-sm">View <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-bell-fill me-2"></i>Notifications
                    </h5>
                    <p class="card-text">View system notifications</p>
                    <a href="/notifications" class="btn btn-light btn-sm">View <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Getting Started</h5>
                </div>
                <div class="card-body">
                    <h6>Features</h6>
                    <ul>
                        <li><strong>Employee Management:</strong> Add and manage employees with supervisor assignment</li>
                        <li><strong>Time Logging:</strong> Track work hours with topics, notes, and approval workflow</li>
                        <li><strong>Time Reports:</strong> View monthly statistics and summaries</li>
                        <li><strong>Context Switcher:</strong> Switch between Employee, Supervisor, and Admin views</li>
                    </ul>

                    <h6 class="mt-3">Quick Actions</h6>
                    <div class="btn-group" role="group">
                        <a href="/employees" class="btn btn-outline-primary">
                            <i class="bi bi-person-plus me-2"></i>Add Employee
                        </a>
                        <a href="/time-logs" class="btn btn-outline-success">
                            <i class="bi bi-plus-circle me-2"></i>Add Time Log
                        </a>
                        <a href="/time-reports" class="btn btn-outline-info">
                            <i class="bi bi-file-earmark-text me-2"></i>View Reports
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">System Info</h5>
                </div>
                <div class="card-body">
                    <p><strong>Version:</strong> 1.0.0</p>
                    <p><strong>Framework:</strong> Blazor WebAssembly</p>
                    <p><strong>Backend APIs:</strong></p>
                    <ul class="small">
                        <li>Employees API (port 5001)</li>
                        <li>Time Loggers API (port 5002)</li>
                        <li>Time Reports API (port 5003)</li>
                    </ul>
                    <div class="alert alert-info small mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Mock data available when APIs are offline
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
