@page "/workspace"
@inject AppStateService AppState
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Workspace</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <EmployeeSelector />
        </div>
    </div>

    @if (string.IsNullOrEmpty(AppState.CurrentEmployeeId))
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Please select an employee context to continue
        </div>
    }
    else
    {
        <ul class="nav nav-tabs mb-4" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(_activeTab == "timeLogs" ? "active" : "")"
                        @onclick="@(() => SetActiveTab("timeLogs"))"
                        type="button">
                    <i class="bi bi-clock-fill me-2"></i>Time Logs
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(_activeTab == "timeReports" ? "active" : "")"
                        @onclick="@(() => SetActiveTab("timeReports"))"
                        type="button">
                    <i class="bi bi-bar-chart-fill me-2"></i>Time Reports
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(_activeTab == "notifications" ? "active" : "")"
                        @onclick="@(() => SetActiveTab("notifications"))"
                        type="button">
                    <i class="bi bi-bell-fill me-2"></i>Notifications
                </button>
            </li>
        </ul>

        <div class="tab-content">
            @if (_activeTab == "timeLogs")
            {
                <TimeLogs />
            }
            else if (_activeTab == "timeReports")
            {
                <TimeReports />
            }
            else if (_activeTab == "notifications")
            {
                <Notifications />
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private string _activeTab = "timeLogs";

    protected override Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;

        if (!string.IsNullOrEmpty(TabQuery))
        {
            _activeTab = TabQuery;
        }

        return Task.CompletedTask;
    }

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
        StateHasChanged();
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
