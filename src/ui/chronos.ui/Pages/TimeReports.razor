@page "/time-reports"
@inject ITimeReportService TimeReportService
@inject IEmployeeService EmployeeService
@inject AppStateService AppState
@implements IDisposable

<PageTitle>Time Reports</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h3>Time Reports</h3>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6 col-lg-4">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-file-earmark-arrow-down me-2"></i>Generate Report File
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="employeeSelect" class="form-label">Select Employee</label>
                        <select id="employeeSelect" class="form-select" @bind="selectedEmployeeId">
                            <option value="">-- Select employee --</option>
                            @foreach (var employee in employees)
                            {
                                <option value="@employee.Id">@employee.FirstName @employee.LastName</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn-primary w-100"
                            @onclick="GenerateReportAsync"
                            disabled="@(string.IsNullOrEmpty(selectedEmployeeId) || isGenerating)">
                        @if (isGenerating)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Generating...</span>
                        }
                        else
                        {
                            <i class="bi bi-download me-2"></i>
                            <span>Generate Report</span>
                        }
                    </button>
                    @if (generateSuccess)
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            <i class="bi bi-check-circle me-2"></i>Report generated successfully!
                        </div>
                    }
                    @if (generateError != null)
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>@generateError
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        </div>
    }
    else if (currentTimeReport != null)
    {
        <div class="row">
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-person-circle me-2"></i>@currentTimeReport.EmployeeName
                        </h5>
                        <h6 class="card-subtitle mb-3 text-muted">
                            <i class="bi bi-calendar me-2"></i>@currentTimeReport.Period
                        </h6>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted">Total Hours:</span>
                                <span class="fs-4 fw-bold text-primary">@currentTimeReport.TotalHours.ToString("F1")h</span>
                            </div>
                        </div>

                        <hr />

                        <div class="row text-center">
                            <div class="col-4">
                                <div class="text-success fw-bold">@currentTimeReport.AcceptedEntries</div>
                                <small class="text-muted">Accepted</small>
                            </div>
                            <div class="col-4">
                                <div class="text-warning fw-bold">@currentTimeReport.PendingEntries</div>
                                <small class="text-muted">Pending</small>
                            </div>
                            <div class="col-4">
                                <div class="text-danger fw-bold">@currentTimeReport.RejectedEntries</div>
                                <small class="text-muted">Rejected</small>
                            </div>
                        </div>
                    </div>
                <div class="card-footer bg-transparent">
                    <button class="btn btn-sm btn-outline-primary w-100">
                        <i class="bi bi-file-earmark-text me-2"></i>View Details
                    </button>
                </div>
            </div>
        </div>
    </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            @if (string.IsNullOrEmpty(AppState.CurrentEmployeeId))
            {
                <span>Please select an employee to view reports.</span>
            }
            else
            {
                <span>No time reports available for selected employee.</span>
            }
        </div>
    }
</div>

@code {
    private TimeReport? currentTimeReport;
    private bool isLoading = false;
    private string? errorMessage;

    private IReadOnlyCollection<Employee> employees = [];
    private string? selectedEmployeeId;
    private bool isGenerating = false;
    private bool generateSuccess = false;
    private string? generateError;

    protected override async Task OnInitializedAsync()
    {
        employees = await EmployeeService.GetAllAsync();
        await LoadTimeReports();
        AppState.OnChange += async () =>
        {
            await LoadTimeReports();
            StateHasChanged();
        };
    }

    private async Task GenerateReportAsync()
    {
        if (string.IsNullOrEmpty(selectedEmployeeId))
            return;

        try
        {
            isGenerating = true;
            generateSuccess = false;
            generateError = null;

            await TimeReportService.GenerateReportFileAsync(selectedEmployeeId);
            generateSuccess = true;
        }
        catch (Exception ex)
        {
            generateError = $"Error generating report: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }

    private async Task LoadTimeReports()
    {
        if (string.IsNullOrEmpty(AppState.CurrentEmployeeId))
        {
            currentTimeReport = null;
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;
            currentTimeReport = await TimeReportService.GetByEmployeeIdAsync(AppState.CurrentEmployeeId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading time reports: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
