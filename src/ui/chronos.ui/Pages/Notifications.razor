@page "/notifications"
@inject AppStateService AppState
@inject INotificationService NotificationService
@implements IDisposable

<PageTitle>Notifications</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h3>Notifications</h3>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        </div>
    }
    else if (string.IsNullOrEmpty(AppState.CurrentEmployeeId))
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Please select an employee context to view notifications.
        </div>
    }
    else if (notifications.Count > 0)
    {
        <div class="list-group">
            @foreach (var notification in notifications)
            {
                <div class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="@notification.IconClass fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-1">@notification.Message</h6>
                                <small class="text-muted">@notification.TimeAgo</small>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => MarkAsReadAsync(notification.Id)">
                            <i class="bi bi-check2"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-bell fs-1"></i>
            <p class="mt-3">No unread notifications</p>
        </div>
    }
</div>

@code {
    private List<NotificationMessage> notifications = new();
    private bool isLoading = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotifications();
        AppState.OnChange += async () => await LoadNotifications();
    }

    private async Task LoadNotifications()
    {
        if (string.IsNullOrEmpty(AppState.CurrentEmployeeId))
        {
            notifications = new List<NotificationMessage>();
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;
            notifications = (await NotificationService.GetUnreadAsync(AppState.CurrentEmployeeId)).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading notifications: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task MarkAsReadAsync(string notificationId)
    {
        if (string.IsNullOrEmpty(AppState.CurrentEmployeeId))
        {
            return;
        }

        try
        {
            await NotificationService.MarkAsReadAsync(notificationId, AppState.CurrentEmployeeId);
            await LoadNotifications();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error marking notification as read: {ex.Message}";
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= async () => await LoadNotifications();
    }
}
