{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppOptions": {
    "Name": "chronos-contracts"
  },
  "DalOptions": {
    "ConnectionString": "ConnectionString",
    "DatabaseName": "DatabaseName"
  },
  "RabbitMqOptions": {
    "HostName": "host",
    "Port": 0,
    "Username": "username",
    "Password": "password",
    "VirtualHost": "/",
    "Routes": {
      "chronos.contracts.core.Events.ContractCreated": {
        "Exchange": "chronos_contracts_core",
        "RoutingKeys": [
          "contract_created"
        ],
        "IsTemporary": true
      }
    }
  }
}
