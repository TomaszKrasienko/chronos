{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppOptions": {
    "Name": "Notifications"
  },
  "DalOptions": {
    "ConnectionString": "ConnectionString",
    "DatabaseName": "DatabaseName"
  },
  "RabbitMqOptions": {
    "HostName": "localhost",
    "Port": 5672,
    "Username": "username",
    "Password": "password",
    "VirtualHost": "/",
    "Routes": {
      "chronos.notifications.core.Events.EmployeeCreated": {
        "Exchange": "chronos_employees_core",
        "Queue": "notifications_employee_created",
        "RoutingKeys": [
          "employee_created"
        ],
        "IsTemporary": false
      },
      "chronos.notifications.core.Events.TimeLogCreated": {
        "Exchange": "chronos_time_loggers_core",
        "Queue": "notifications_time_log_created",
        "RoutingKeys": [
          "time_log_created"
        ],
        "IsTemporary": false
      },
      "chronos.notifications.core.Events.SupervisorAssigned": {
        "Exchange": "chronos_employees_core",
        "Queue": "notifications_supervisor_assigned",
        "RoutingKeys": [
          "supervisor_assigned"
        ],
        "IsTemporary": false
      }
    }
  }
}
