{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppOptions": {
    "Name": "chronos-time-logs"
  },
  "DalOptions": {
    "ConnectionString": "ConnectionString",
    "DatabaseName": "DatabaseName"
  },
  "OutboxOptions": {
    "ConnectionString": "Host=localhost;Port=10014;Database=chronos_time_logs;Username=chronos;Password=chronos"
  },
  "RabbitMqOptions": {
    "HostName": "host",
    "Port": 0,
    "Username": "username",
    "Password": "password",
    "VirtualHost": "/",
    "Routes": {
      "chronos.time_logs.core.Events.TimeLogWaitingForAcceptationCreated": {
        "Exchange": "chronos_time-logs_core",
        "RoutingKeys": [
          "time_log_waiting_for_acceptation_created"
        ],
        "IsTemporary": true
      },
      "chronos.time_logs.core.Events.External.TimeLogAutomaticallyAccepted": {
        "Exchange": "chronos_contracts_core",
        "RoutingKeys": [
          "time_log_automatically_accepted"
        ],
        "Queue": "time_logs_time_log_automatically_accepted",
        "IsTemporary": false
      }
    }
  },
  "HttpCommunicationOptions": {
    "Enabled": true,
    "Clients": [
      {
        "Name": "HttpEmployeesClient",
        "Uri": "http://employees:8080"
      },
      {
        "Name": "HttpContractsClient",
        "Uri": "http://contracts:8080"
      }
    ]
  }
}
